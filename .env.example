# Sarthink Configuration Template

# --- Twitter Context Fetching (SocialData API) ---
# Get yours at https://socialdata.tools/
TWITTER_SOCIALDATA_API_KEY=your_socialdata_api_key_here

# --- Reddit Context Fetching (Reddit OAuth) ---
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT="SarthinkContextFetcher/1.0 by u/your_username"
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password
