# Sarthink configuration — copy to .env and fill in what you need.

# --- The memory assistant (chat, dossier themes, day review) ---
# OpenRouter API key (https://openrouter.ai): DeepSeek's models (deepseek-flash-latest, deepseek-pro-latest) for
# the assistant, plus the 8b search embeddings. Without it Sarthink falls back to DEEPSEEK_API_KEY (DeepSeek's own
# API); with neither, the graph, search, stats, commitments inbox and "on this day" still work.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Which data to load (optional; run.py --demo sets these for you) ---
# SARTHINK_DATA=demo                 # folder with db/, index/, graph/ (default: processed_data)
# SARTHINK_EMBED_MODEL=0.6b          # 0.6b runs on CPU; 8b needs a GPU encoder (see EMBED_URL)
# EMBED_URL=http://127.0.0.1:8101    # remote GPU embed_server (scripts/index/embed_server.py) via SSH tunnel

# --- Only for rebuilding from your own exports ---
# Twitter context fetching (SocialData API, https://socialdata.tools/)
TWITTER_SOCIALDATA_API_KEY=
# Reddit context fetching (create an app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="SarthinkContextFetcher/1.0 by u/your_username"
REDDIT_USERNAME=
REDDIT_PASSWORD=
# vast.ai API key, for renting a GPU to build embeddings
VAST_API_KEY=
