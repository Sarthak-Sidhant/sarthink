# Sarthink Gitignore

# Data & Personal Exports
archive/
archive/*
processed_data/
config/identity_map.json
.env
.env.*
!.env.example

# Raw Data Traces & Databases
*.js
*.jsonl
*.csv
*.db
*.sqlite

# Archives & Media
*.zip
*.tar
*.tar.gz
*.gz
*.mp4
*.mov
*.avi
graph-thing.mp4

# Cache & Metadata
context_cache.json
users.jsonl
__pycache__/
*.pyc

# IDEs & System
.vscode/
.idea/
.DS_Store

# Temporary & Legacy Folders
context/reddit/Reddit_Context_Archive (Copy)
context/reddit/Reddit_Context_Archive
context/reddit/addn.py
context/reddit/test.py
# The fictional demo archive IS committed (judges run it); runtime files are not
!demo/
!demo/**
demo/db/user_notes.db
demo/db/twitter_users.db
demo/db/*-wal
demo/db/*-shm
